# Copy to ".env" and fill in real values for local testing.
# These same keys go into the Render dashboard for production.
# NEVER commit the real .env — it's gitignored.

# Your Gmail address (SMTP login + the From address).
GMAIL_USER=rjkowdeeng@gmail.com

# A 16-char Google App Password (Google Account → Security → App passwords).
# Requires 2-Step Verification to be ON. This is NOT your normal Gmail password.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (usually your own Gmail).
CONTACT_TO=rjkowdeeng@gmail.com

# Optional — local port (Render sets this automatically in production).
# PORT=3000
