# Copy to ".env" and fill in real values for local testing.
# These same keys go into the Render dashboard for production.
# NEVER commit the real .env — it's gitignored.

# Resend API key — https://resend.com/api-keys (starts with "re_").
# Email is sent over Resend's HTTPS API because Render's free tier blocks SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
# On Resend's free tier (no verified domain) this MUST be the email address
# you signed up to Resend with.
CONTACT_TO=rjkowdeeng@gmail.com

# Optional — the "From" address. Defaults to Resend's shared sender, which
# works without owning a domain. Once you verify your own domain in Resend,
# set this to e.g.  IN.DI.GIT.AL. <hello@yourdomain.com>
# MAIL_FROM=IN.DI.GIT.AL. <onboarding@resend.dev>

# Optional — local port (Render sets this automatically in production).
# PORT=3000
